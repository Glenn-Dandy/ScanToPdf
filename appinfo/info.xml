<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>scantopdf</id>
    <name>Scan to PDF</name>
    <summary>Scan documents and photos straight into your files as PDF</summary>
    <description><![CDATA[Adds a Scan to PDF entry to the New menu in Files. Uses any scanner SANE can reach, connected locally or over the network, with an optional button on the scanner.

Requires the sane-utils package on the server, for example: sudo apt install sane-utils]]></description>
    <version>0.3.3</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>Glenn-Dandy</author>
    <namespace>ScanToPdf</namespace>
    <documentation>
        <user>https://github.com/Glenn-Dandy/ScanToPdf#readme</user>
        <admin>https://github.com/Glenn-Dandy/ScanToPdf#readme</admin>
    </documentation>
    <category>files</category>
    <category>tools</category>
    <website>https://github.com/Glenn-Dandy/ScanToPdf</website>
    <bugs>https://github.com/Glenn-Dandy/ScanToPdf/issues</bugs>
    <repository type="git">https://github.com/Glenn-Dandy/ScanToPdf.git</repository>
    <screenshot>https://raw.githubusercontent.com/Glenn-Dandy/ScanToPdf/main/screenshots/dialog.jpg</screenshot>
    <screenshot>https://raw.githubusercontent.com/Glenn-Dandy/ScanToPdf/main/screenshots/settings.jpg</screenshot>
    <dependencies>
        <nextcloud min-version="33" max-version="36"/>
    </dependencies>
    <commands>
        <command>OCA\ScanToPdf\Command\RunJob</command>
        <command>OCA\ScanToPdf\Command\ButtonPressed</command>
    </commands>
    <settings>
        <admin>OCA\ScanToPdf\Settings\Admin</admin>
        <admin-section>OCA\ScanToPdf\Settings\AdminSection</admin-section>
    </settings>
</info>
